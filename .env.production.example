APP_NAME="Greenwood International School SMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DEMO_MODE=false
APP_URL=https://sms.yourschool.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Production Database (MySQL / MariaDB / PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_sms_prod
DB_USERNAME=sms_db_user
DB_PASSWORD=StrongSecurePasswordHere!

# Sessions & Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue & Background Jobs
QUEUE_CONNECTION=database

# Application Cache
CACHE_STORE=database

# Mail Configuration (SMTP / SES / Resend)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@yourschool.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI Gateway (Production LLM Driver)
AI_DRIVER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Multi-Channel SMS & WhatsApp Gateway
SMS_GATEWAY_DRIVER=log
# SMS_GATEWAY_DRIVER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
